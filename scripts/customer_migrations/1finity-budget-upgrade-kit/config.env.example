# Copy to config.env and review every value before use.
KUBECTL="sudo k0s kubectl"
NAMESPACE="openhands"
OPENHANDS_DEPLOYMENT="openhands"
OPENHANDS_CONTAINER="openhands"
LITELLM_DEPLOYMENT="openhands-litellm"
EXPECTED_SOURCE_VERSION="0.55.1-rc.1"
EXPECTED_TARGET_VERSION="0.74.0"

# 1finity uses external PostgreSQL with TLS. The kit creates this temporary
# in-cluster client pod from OpenHands' existing wait-for-db init container,
# preserving secret references without exporting credentials.
DATABASE_MODE="external"
DB_EXEC_POD="1finity-budget-upgrade-db-tools"
DB_EXEC_CONTAINER="db-tools"
DB_HELPER_SOURCE_INIT_CONTAINER="wait-for-db"

# Embedded PostgreSQL alternative:
# DATABASE_MODE="embedded"
# DB_EXEC_POD="openhands-postgresql-0"
# DB_EXEC_CONTAINER="postgresql"

APP_DB="openhands"
LITELLM_DB="litellm"
BUDGET_CRONJOB="openhands-budget-maintenance"
MAINTENANCE_CRONJOB="openhands-maintenance-tasks"
PREFLIGHT_JOB="openhands-budget-preflight"
GATE_JOB="openhands-budget-reconcile-gate"

# Preserve the current absolute LiteLLM caps as OpenHands monthly limits. The
# current cycle starts on this day with zero baselines; normal rollover takes
# over after the next reset.
MIGRATION_RESET_DAY="1"
MIGRATION_PLAN_MAX_AGE_SECONDS="3600"
BUDGET_CRON_VERIFICATION_RUNS="2"

# Use a new absolute directory for each production attempt.
EVIDENCE_DIR="/home/openhands/1finity-budget-upgrade-YYYYMMDD-HHMM"
