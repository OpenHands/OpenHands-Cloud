apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: sysbox-storage-smoke
  namespace: openhands-runtimes
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: managed-csi
  resources:
    requests:
      storage: 2Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: sysbox-storage-expand-smoke
  namespace: openhands-runtimes
spec:
  runtimeClassName: sysbox-runc
  hostUsers: false
  restartPolicy: Never
  nodeSelector:
    kubernetes.io/hostname: ${SECOND_SANDBOX_NODE}
  containers:
    - name: smoke
      image: ubuntu:24.04
      command: [bash, -lc]
      args:
        - 'set -eu; grep -Fx aks-sysbox-storage-ok /workspace/probe.txt; df -h /workspace; test "$(df -B1 /workspace | tail -1 | awk ''{print $2}'')" -gt 1500000000; echo SYSBOX_AZURE_DISK_EXPANSION_PASS'
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: "1"
          memory: 512Mi
      volumeMounts:
        - name: workspace
          mountPath: /workspace
  volumes:
    - name: workspace
      persistentVolumeClaim:
        claimName: sysbox-storage-smoke
