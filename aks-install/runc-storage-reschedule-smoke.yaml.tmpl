apiVersion: v1
kind: Pod
metadata:
  name: runc-storage-reschedule-smoke
  namespace: openhands-runtimes
spec:
  restartPolicy: Never
  nodeSelector:
    kubernetes.io/hostname: ${SECOND_SANDBOX_NODE}
  containers:
    - name: smoke
      image: ubuntu:24.04
      command: [bash, -lc]
      args:
        - 'set -eu; grep -Fx aks-runc-storage-ok /workspace/probe.txt; df -h /workspace; echo RUNC_AZURE_DISK_RESCHEDULE_PASS'
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: "1"
          memory: 512Mi
      volumeMounts:
        - name: workspace
          mountPath: /workspace
  volumes:
    - name: workspace
      persistentVolumeClaim:
        claimName: runc-storage-smoke
